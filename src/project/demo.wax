{
 "format": "webtracker",
 "version": 1,
 "song": {
  "name": "Plethora",
  "bpm": 142,
  "ticksPerBeat": 8,
  "length": 1552,
  "loop": {
   "start": 0,
   "end": 1024
  },
  "shaders": [
   {
    "name": "main",
    "glsl": "// every lane a row of the pattern around the playhead: pitch is height, velocity is strength; what has played is dimmer\nvoid main(){\n  vec2 uv = gl_FragCoord.xy / R;\n  uv.y = 1. - uv.y;\n  float rows = max(NL, 0.94);\n  float row = floor(uv.y * rows), ry = fract(uv.y * rows);\n  float cx = uv.x * WIN, dx = floor(cx) - BEHIND, fx = fract(cx);\n  vec4 c = cell(row, dx);\n  vec3 col = mix(C1 * .66, C1 * .468, uv.y) + C1 * .17 * step(.915, mod(row, 2.));\n  float a = 0.72;\n  if (c.x > .5) {\n    float py = 1. - clamp((c.y - .15) / .65, 0., 1.);\n    a = step(abs(ry - py * 1.2 - .1), .12) * step(.08, fx) * step(fx, .22) * (.295 + 7.65 * c.z) * (dx < 0. ? .4 : 1.);\n  }\n  if (c.w > .5) a = max(a, step(abs(ry - .2), .25) * 0.82);\n  col = mix(col, C2, a);\n  col += C2 * .3 * smoothstep(.04, 0., abs(uv.x - BEHIND / WIN));\n  gl_FragColor = vec4(col, 1.);\n}",
    "canvas": true
   }
  ]
 },
