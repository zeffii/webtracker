{
 "format": "webtracker",
 "version": 1,
 "song": {
  "name": "chords in the nodes",
  "bpm": 118,
  "ticksPerBeat": 4,
  "length": 256,
  "loop": {
   "start": 0,
   "end": 256
  },
  "info": "A demo for the Node Sequencer (its tab). Every chord on the pad, the bass and the arpeggio comes from a Pchord node: a list of chord names, one a line, stepped by the bar or the beat. The pad rolls its chord up and down (strum, direction alternate) into a note node set to poly; the bass plays the root of the same list and echoes it between the beats with delay nodes (one of them behind a chance node). The arpeggio sits in group B, which a run node starts at bar four (its list begins at the chord of that bar); it steps its list on every beat (the dot is a rest) and a chance node drops the odd note. An lfo sweeps the pad filter over eight bars and an ad envelope plucks the arpeggio filter on every beat. The kick and the hats are ordinary pattern lanes. Edit a chord name in the Pchord lists and the song follows.",
  "nodeseq": {
   "sub": 4,
   "groups": [
    {
     "name": "A",
     "on": true
    },
    {
     "name": "B",
     "on": false
    },
    {
     "name": "C",
     "on": true
    },
    {
     "name": "D",
     "on": true
    },
    {
     "name": "E",
     "on": true
    },
    {
     "name": "F",
     "on": true
    },
    {
     "name": "G",
     "on": true
    },
    {
     "name": "H",
     "on": true
    }
   ],
   "nodes": [
    {
     "id": "clk",
     "type": "clock",
     "x": 20,
     "y": 160
    },
    {
     "id": "padChords",
     "type": "Pchord",
     "x": 220,
     "y": 20,
     "params": {
      "octave": 3,
      "notes": 4,
      "strum": 2,
      "direction": 2
     },
     "data": {
      "text": "A min7\nD min7\nG 7\nC maj7\nF maj7\nB min7b5\nE 7\nA min7"
     }
    },
    {
     "id": "padNote",
     "type": "note",
     "x": 470,
     "y": 20,
     "params": {
      "poly": 1,
      "len": 15,
      "vel": 0.62
     },
     "data": {
      "target": "pad"
     }
    },
    {
     "id": "bassChords",
     "type": "Pchord",
     "x": 220,
     "y": 240,
     "params": {
      "octave": 1,
      "notes": 1
     },
     "data": {
      "text": "A min7\nD min7\nG 7\nC maj7\nF maj7\nB min7b5\nE 7\nA min7"
     }
    },
    {
     "id": "d1",
     "type": "delay",
     "x": 450,
     "y": 200,
     "params": {
      "subs": 14
     }
    },
    {
     "id": "d2",
     "type": "delay",
     "x": 450,
     "y": 260,
     "params": {
      "subs": 24
     }
    },
    {
     "id": "c3",
     "type": "chance",
     "x": 450,
     "y": 320,
     "params": {
      "p": 0.6
     }
    },
    {
     "id": "d3",
     "type": "delay",
     "x": 600,
     "y": 320,
     "params": {
      "subs": 40
     }
    },
    {
     "id": "d4",
     "type": "delay",
     "x": 450,
     "y": 400,
     "params": {
      "subs": 52
     }
    },
    {
     "id": "bassNote",
     "type": "note",
     "x": 760,
     "y": 260,
     "params": {
      "len": 1.5,
      "vel": 0.8
     },
     "data": {
      "target": "bass"
     }
    },
    {
     "id": "sweep",
     "type": "lfo",
     "x": 20,
     "y": 440,
     "params": {
      "rate": 0.125,
      "sync": 1,
      "shape": 1,
      "depth": 1,
      "center": 0.5
     }
    },
    {
     "id": "padCut",
     "type": "set",
     "x": 220,
     "y": 440,
     "params": {
      "lo": 0.25,
      "hi": 0.85,
      "smooth": 40
     },
     "data": {
      "target": "pad.synth.cutoff"
     }
    },
    {
     "id": "every16",
     "type": "every",
     "x": 220,
     "y": 100,
     "params": {
      "n": 64,
      "offset": 16
     }
    },
    {
     "id": "start",
     "type": "run",
     "x": 400,
     "y": 100,
     "params": {
      "group": 2,
      "mode": 0
     }
    },
    {
     "id": "arpChords",
     "type": "Pchord",
     "x": 220,
     "y": 540,
     "group": 1,
     "params": {
      "octave": 4,
      "notes": 4,
      "strum": 2,
      "direction": 2
     },
     "data": {
      "text": "F maj7\nF maj7\nF maj7\nF maj7\nB min7b5\nB min7b5\nB min7b5\n.\nE 7\nE 7\nE 7\nE 7\nA min7\nA min7\nA min7\n.\nA min7\nA min7\nA min7\nA min7\nD min7\nD min7\nD min7\n.\nG 7\nG 7\nG 7\nG 7\nC maj7\nC maj7\nC maj7\n."
     }
    },
    {
     "id": "keep",
     "type": "chance",
     "x": 470,
     "y": 540,
     "group": 1,
     "params": {
      "p": 0.85
     }
    },
    {
     "id": "arpNote",
     "type": "note",
     "x": 640,
     "y": 540,
     "group": 1,
     "params": {
      "len": 0.5,
      "vel": 0.55
     },
     "data": {
      "target": "arp"
     }
    },
    {
     "id": "pluck",
     "type": "ad",
     "x": 220,
     "y": 640,
     "group": 1,
     "params": {
      "attack": 3,
      "decay": 240
     }
    },
    {
     "id": "arpCut",
     "type": "set",
     "x": 400,
     "y": 640,
     "group": 1,
     "params": {
      "lo": 0.3,
      "hi": 0.9,
      "smooth": 5
     },
     "data": {
      "target": "arp.du.cutoff"
     }
    }
   ],
   "wires": [
    {
     "from": "clk.bar",
     "to": "padChords.next"
    },
