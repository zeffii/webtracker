{
 "format": "webtracker",
 "version": 1,
 "song": {
  "name": "weights of a chord",
  "bpm": 118,
  "ticksPerBeat": 4,
  "length": 256,
  "loop": {
   "start": 0,
   "end": 256
  },
  "info": "A demo for the Chord, Phrase and Voicing nodes (Node Sequencer tab). Four Chord nodes hold the chords, each with its own volume for every note (drag the bars in its panel); the Phrase node plays the chord whose number arrives at index, here the bar number, so they come round in turn, and the lit chord and wire show which. Variation nudges each note a little every time, and an lfo moves the tilt of all four, so the voicing slowly turns from bottom-heavy to top-heavy and back. The bass is the root of the playing chord, an octave or two down, with an echo. The arpeggio waits in group B until bar four. The kick and the hats are pattern lanes.",
  "nodeseq": {
   "sub": 4,
   "groups": [
    {
     "name": "A",
     "on": true
    },
    {
     "name": "B",
     "on": false
    },
    {
     "name": "C",
     "on": true
    },
    {
     "name": "D",
     "on": true
    },
    {
